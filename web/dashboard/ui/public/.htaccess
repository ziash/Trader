# Trader Dashboard: Apache settings for the web root of trader.uzlabz.com (dashboard.md §4).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# HTTPS only, and only under trader.uzlabz.com (the folder also answers at uzlabz.com/trader).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^trader\.uzlabz\.com$ [NC]
RewriteRule ^(.*)$ https://trader.uzlabz.com/$1 [R=301,L]

# Hand the Authorization header on to PHP (machine sign-in and access tokens).
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# The API and the sign-in addresses go to the PHP front controller; its code lives outside the web root.
RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule ^(api|auth)(/|$) api/index.php [L]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  # Pages are checked for a newer version on every visit; Next.js's own files carry a hash in their name.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
