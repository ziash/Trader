{
    "name": "trader/dashboard-api",
    "description": "Trader Dashboard API: sign-in, roles, data and controls (docs/dashboard/dashboard.md §4.1, §5)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "TraderDash\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TraderDash\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.3.0" },
        "sort-packages": true
    }
}
