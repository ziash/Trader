# systemd user service for TM — Trade Manually (shared.md §3: one systemd user service per bot; tm.md §10).
# Installed by scripts/deploy-tm.sh into ~/.config/systemd/user/. Runs the published build in
# ~/tradebot/bin/TM (not the repo build), so code changes do not affect the running bot.
#
#   systemctl --user enable --now trader-tm   start now and at every login
#   systemctl --user status trader-tm         is it running?
#   journalctl --user -u trader-tm -f         live console output
#   systemctl --user stop trader-tm           stop (positions keep their hedges and stops on the server)

[Unit]
Description=Trader TM - Trade Manually (cTrader demo accounts)

[Service]
Type=simple
ExecStart=/usr/bin/dotnet %h/tradebot/bin/TM/Trader.TM.dll
WorkingDirectory=%h/tradebot
# Restart after a crash or an unexpected stop, but not after a fatal problem the bot reported itself
# (exit 1: e.g. refresh token rejected or bad config; exit 2: bad options) — those need a human.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=1 2
# Ctrl+C equivalent: TM finishes its current order, sends the "stopped" pop-up and exits.
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

[Install]
WantedBy=default.target
