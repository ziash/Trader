# systemd user service for Scout (shared.md §3: one systemd user service per bot; scout.md §4).
# Installed by scripts/deploy-scout.sh into ~/.config/systemd/user/. Runs the published build in
# ~/tradebot/bin/Scout (not the repo build), so code changes do not affect the running bot.
#
#   systemctl --user enable --now trader-scout   start now and at every login
#   systemctl --user status trader-scout         is it running?
#   journalctl --user -u trader-scout -f         live console output
#   systemctl --user stop trader-scout           stop (its pending orders stay and expire by themselves; TM manages the filled ones)

[Unit]
Description=Trader Scout - pause-then-stop setups, first orders for TM (cTrader demo accounts)

[Service]
Type=simple
ExecStart=/usr/bin/dotnet %h/tradebot/bin/Scout/Trader.Scout.dll
WorkingDirectory=%h/tradebot
# Restart after a crash or an unexpected stop, but not after a fatal problem the bot reported itself
# (exit 1: e.g. refresh token rejected or bad config; exit 2: bad options) — those need a human.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=1 2
# Ctrl+C equivalent: Scout finishes its current order request, sends the "stopped" pop-up and exits.
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

[Install]
WantedBy=default.target
