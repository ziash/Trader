  // Forex in pips; crypto in USD per lot (1 coin). Normal on 19-Oct: forex under 1 pip,
  // BTCUSD $5-15, ETHUSD $2-3, hence the ETHUSD override.
  "alerts": {
    "forexSpreadPips": 2,
    "forexSlipPips": 1,
    "cryptoSpreadUsd": 50,
    "cryptoSlipUsd": 10,
    "symbols": { "ETHUSD": { "spreadUsd": 10, "slipUsd": 3 } }
  }
}
