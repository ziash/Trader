{
  // Scout (docs/bots/scout/scout.md; setup rules: github.com/ziash/Scout docs/spec.md). Live copy: ~/tradebot/config/scout.json
  // Each chart: symbol, timeframe (H1, H4, D1) and mode: "watch" = alerts only, "trade" = Scout places the first stop
  // order of each setup and TM takes it over ("Scout-" in tm.json's takeOver).
  // Trial run from 03-Nov-2026 (Scout spec §4.6): trade, 1H. From 04-Nov-2026 (owner): IC Markets only, top three
  // symbols per market (the Audit Bot's 18, with EURJPY for EURGBP; scout.md §7). TM lists the same symbols.
  // From 07-Nov-2026 (owner): Pepperstone only, same 18 symbols, for fresh results; IC Markets left (its waiting orders expire).
  "accounts": [
    // Our names; symbolNames maps the five that Pepperstone calls differently (as audit.brokerB.json).
    { "broker": "brokerB", "accountId": 49124666,
      "symbolNames": { "XTIUSD": "SpotCrude", "XBRUSD": "SpotBrent", "XNGUSD": "NatGas", "USTEC": "NAS100", "DE40": "GER40" },
      "charts": [
      // forex majors
      { "symbol": "EURUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "GBPUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "USDJPY", "timeframe": "H1", "mode": "trade" },
      // forex crosses
      { "symbol": "GBPJPY", "timeframe": "H1", "mode": "trade" },
      { "symbol": "EURJPY", "timeframe": "H1", "mode": "trade" },
      { "symbol": "AUDJPY", "timeframe": "H1", "mode": "trade" },
      // metals
      { "symbol": "XAUUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "XAGUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "XPTUSD", "timeframe": "H1", "mode": "trade" },
      // indices
      { "symbol": "US500", "timeframe": "H1", "mode": "trade" },
      { "symbol": "USTEC", "timeframe": "H1", "mode": "trade" },
      { "symbol": "DE40", "timeframe": "H1", "mode": "trade" },
      // energies
      { "symbol": "XTIUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "XBRUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "XNGUSD", "timeframe": "H1", "mode": "trade" },
      // crypto
      { "symbol": "BTCUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "ETHUSD", "timeframe": "H1", "mode": "trade" },
      { "symbol": "SOLUSD", "timeframe": "H1", "mode": "trade" }
    ] }
  ],

  "lots": 0.1,            // per Scout order on symbols not listed below (forex); TM's mirror adds the same
  // Own size per symbol (owner, 04-Nov-2026; scout.md §2): small test sizes, chosen so a typical 1H move (ATR, last
  // 100 candles on 04-Nov) is worth about $15 per order on every symbol, as on forex at 0.1 lot. In brackets: 1 lot at
  // Pepperstone (from 07-Nov-2026; the same as IC Markets except silver), and $ per 1H ATR at this size.
  // At IC Markets (to 07-Nov): XAGUSD 0.03 (1 lot = 1,000 oz), XNGUSD 0.5 (its minimum, ≈ $135).
  "lotsBySymbol": {
    "XAUUSD": 0.01,   // 100 oz; ≈ $17
    "XAGUSD": 0.01,   // 5,000 oz; ≈ $22 — the minimum (0.006 would be $13)
    "XPTUSD": 0.01,   // 100 oz; ≈ $12
    "US500": 0.7,     // 1 index unit; ≈ $16
    "USTEC": 0.1,     // 1 index unit; ≈ $15
    "DE40": 0.2,      // 1 index unit, in EUR; ≈ $19 (step 0.1)
    "XTIUSD": 0.15,   // 100 barrels; ≈ $14
    "XBRUSD": 0.15,   // 100 barrels; ≈ $16
    "XNGUSD": 0.06,   // 10,000 MMBtu; ≈ $16 (minimum 0.01)
    "BTCUSD": 0.04,   // 1 BTC; ≈ $16
    "ETHUSD": 0.9,    // 1 ETH; ≈ $16
    "SOLUSD": 20      // 1 SOL; ≈ $15 (minimum 1 lot)
  },
  // Margin budget (scout.md §2.5, issue-log.md #1): a new order only while the margin in use plus marginFactor × the
  // margin of Scout's waiting orders and the new one (TM's mirror and two hedges) stays within marginUsePercent of equity.
  "marginUsePercent": 50,
  "marginFactor": 4,
  // Losses that stop new entries, in % of equity (scout.md §2.7). TM keeps managing open positions. Starting values, to calibrate on replay.
  "limits": { "dailyLossPercent": 3, "weeklyLossPercent": 6, "peakDrawdownPercent": 15 },
  "expiryCandles": 16,    // an unfilled order expires on the server this many candles after it is placed (Scout spec §4.2)
  "historyDays": 30,      // past candles read at start to rebuild the state

  // Scout spec §3.2, the same defaults as Scout_Pine; leave out to use them.
  "setup": {
    "pushBody": 0.6, "minMove": 1.5, "minPause": 2, "maxPause": 16, "maxPauseHeight": 3.0, "maxRetrace": 0.6,
    "reversalAfter": 4, "flipAtr": 3.0, "channel": 20, "atrLength": 14, "level": "smart", "wickTolerance": 0.6, "offset": 0
  }
}
