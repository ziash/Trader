{
  // TM — Trade Manually (docs/bots/tm.md). Live copy: ~/tradebot/config/tm.json
  // Mains (your unlabelled positions) on these symbols are taken over; everything else stays yours.
  "accounts": [
    // brokerA: Scout's 18 symbols from 04-Nov-2026 (scout.md §7) plus EURGBP (Scout traded it before).
    { "broker": "brokerA", "accountId": 49123893, "symbols": [
      "EURUSD", "GBPUSD", "USDJPY", "GBPJPY", "EURJPY", "AUDJPY", "EURGBP",
      "XAUUSD", "XAGUSD", "XPTUSD", "US500", "USTEC", "DE40", "XTIUSD", "XBRUSD", "XNGUSD",
      "BTCUSD", "ETHUSD", "SOLUSD"] },
    // brokerB: Scout's 18 symbols from 07-Nov-2026 (Scout moved to Pepperstone, scout.md §7) plus EURGBP; brokerA's list
    // stays so TM keeps managing the open IC Markets trades. Our names; symbolNames maps Pepperstone's.
    { "broker": "brokerB", "accountId": 49124666, "symbols": [
      "EURUSD", "GBPUSD", "USDJPY", "GBPJPY", "EURJPY", "AUDJPY", "EURGBP",
      "XAUUSD", "XAGUSD", "XPTUSD", "US500", "USTEC", "DE40", "XTIUSD", "XBRUSD", "XNGUSD",
      "BTCUSD", "ETHUSD", "SOLUSD"],
      "symbolNames": { "XTIUSD": "SpotCrude", "XBRUSD": "SpotBrent", "XNGUSD": "NatGas", "USTEC": "NAS100", "DE40": "GER40" } }
  ],

  // Hedge level when your order has no stop-loss: this % of the average daily range of the last N days,
  // but at least spreadFloor × the current spread (tm.md §3).
  "rangePercent": 15,
  "rangeDays": 3,
  "spreadFloor": 5,

  // In R = distance from a leg's entry to the hedge level (tm.md §4, §5).
  "armR": 1,          // A: hedge exit armed once the hedge is this far in profit
  "hedgeStopR": 0.5,  // B: hedge stop this far behind its fill until armed
  "warnR": 2,         // pop-up warning
  "closeR": 3,        // leg and its hedge closed

  // Labels TM takes over as mains (tm.md §2.1): "" = no label (your manual trades); any other entry matches
  // labels that start with it, e.g. "AuditBot-". Example: ["", "ABC"]. Default when missing: [""].
  // "Scout-": the first orders Scout places (docs/bots/scout/scout.md; tm.md decision 12), from 03-Nov-2026.
  "takeOver": ["", "Scout-"],

  "mirrorWithinSeconds": 60,   // a position older than this when TM first sees it: hedges only, no mirror

  // Margin level = equity ÷ margin in use (tm.md §5.1, issue-log.md #1). Below marginWarnLevel: no new mirrors and a
  // pop-up; below marginRescueLevel (IC Markets' margin call): TM closes the trade holding the most margin, one at a time.
  "marginWarnLevel": 300,
  "marginRescueLevel": 100,

  // Spikes (tm.md §5.2, issue-log.md #2). Which price fires TM's hedges and the stops it sets: "DoubleOpposite" = the
  // other side (a buy-stop on the bid, a sell-stop on the ask), two prices in a row; "Trade" = the broker's default.
  // While a symbol's spread is above spreadGuardFactor × its usual (median of the last 2 h), and from rolloverBeforeMinutes
  // before a close to rolloverAfterMinutes after a reopening (the broker's hours), TM's own reactions to the price wait —
  // for at most spreadGuardMaxMinutes when only the spread is wide.
  "stopTrigger": "DoubleOpposite",
  "spreadGuardFactor": 5,
  "spreadGuardMaxMinutes": 15,
  "rolloverBeforeMinutes": 5,
  "rolloverAfterMinutes": 15,

  // Pop-ups (tm.md §6): before each NFP/CPI release in news-releases.json and the Friday close (17:00 New York),
  // and when the connection to cTrader has been down this long.
  "alertMinutesBefore": 10,
  "disconnectAlertSeconds": 60,

  // Used only if the broker's daily candles cannot be fetched; in price.
  "fallbackDistance": { "AUDJPY": 0.12, "EURGBP": 0.0006, "EURUSD": 0.0010, "GBPJPY": 0.22, "BTCUSD": 375, "ETHUSD": 15 }
}
